# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Authentication & Google Sheets Configuration (Server Side Only)
ADMIN_PIN=YOUR_ADMIN_PIN_HERE
SHEET_ID_AVENIDA=YOUR_AVENIDA_SHEET_ID
SHEET_ID_TREBOL=YOUR_TREBOL_SHEET_ID
SHEET_ID_ELNENE=YOUR_ELNENE_SHEET_ID
PORT=3000
